<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Reino Arcano</title>
<style>
*{box-sizing:border-box;touch-action:manipulation}
body{margin:0;overflow:hidden;background:#10172b;color:white;font-family:Arial}
canvas{display:block;width:100vw;height:100dvh;touch-action:none}
#hud{position:fixed;top:10px;left:10px;background:#10172be8;padding:10px;border-radius:12px;font-size:13px;z-index:2}
.bar{height:8px;width:125px;background:#333;margin:5px 0 8px;border-radius:9px;overflow:hidden}
.fill{height:100%;width:100%}#hp{background:#ff475f}#mp{background:#36c9ff}
#controls{position:fixed;bottom:15px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:end;z-index:3}
#stick{width:120px;height:120px;border-radius:50%;background:#ffffff20;border:2px solid #ffffff55;position:relative;touch-action:none}
#knob{position:absolute;width:48px;height:48px;border-radius:50%;background:#8bdcff;left:34px;top:34px}
.actions{display:grid;grid-template-columns:repeat(2,62px);gap:8px}
button{background:#294779;color:white;border:1px solid #ffffff66;border-radius:15px;font-weight:bold}
.actions button{height:55px;font-size:12px}
#menu{position:fixed;inset:0;background:#080e1cee;display:grid;place-items:center;text-align:center;padding:24px;z-index:5}
#menu section{max-width:340px}#menu h1{font-size:32px;color:#83eaff}
#menu p{line-height:1.5;color:#d2dcf4}
#start{background:#6945d5;padding:16px 35px;font-size:17px}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="hud"><b>🧙 REINO ARCANO</b><br>❤️ Vida: <span id="ht">100</span><div class="bar"><div class="fill" id="hp"></div></div>🔷 Mana: <span id="mt">100</span><div class="bar"><div class="fill" id="mp"></div></div>Derrotados: <span id="score">0</span></div>
<div id="controls">
<div id="stick"><div id="knob"></div></div>
<div class="actions"><button id="magic">✨ MAGIA</button><button id="attack">⚔ ATAQUE</button><button id="heal">💚 CURAR</button><button id="dash">💨 ESQUIVA</button></div>
</div>
<div id="menu"><section><h1>⚔ REINO ARCANO</h1><p>Explore o reino, derrote monstros e use magia! O mago guardião luta ao seu lado.</p><p>Analógico para andar. Botões para atacar, lançar magia, curar e esquivar.</p><button id="start">JOGAR</button></section></div>
<script>
const c=document.getElementById('game'),ctx=c.getContext('2d');
let W,H,last=0,running=false,score=0,time=0,spawnT=0;
const hero={x:200,y:200,hp:100,mp:100,face:1,inv:0};
const ally={x:150,y:200,cd:0};
let enemies=[],particles=[],move={x:0,y:0};
function resize(){W=innerWidth;H=innerHeight;c.width=W*devicePixelRatio;c.height=H*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0)}
addEventListener('resize',resize);resize();
function spawn(){let a=Math.random()*6.283;enemies.push({x:Math.max(20,Math.min(W-20,hero.x+Math.cos(a)*W*.55)),y:Math.max(90,Math.min(H-20,hero.y+Math.sin(a)*H*.45)),hp:50,r:16,speed:40+Math.random()*20})}
function burst(x,y,color){for(let i=0;i<12;i++)particles.push({x,y,vx:(Math.random()-.5)*200,vy:(Math.random()-.5)*200,life:.5,color})}
function nearest(range){let best=null,dist=range;for(let e of enemies){let d=Math.hypot(e.x-hero.x,e.y-hero.y);if(d<dist){dist=d;best=e}}return best}
function hit(e,n,color){if(!e)return;e.hp-=n;burst(e.x,e.y,color);if(e.hp<=0){enemies=enemies.filter(q=>q!==e);score++;document.getElementById('score').textContent=score}}
function magic(){if(!running||hero.mp<22)return;hero.mp-=22;let e=nearest(300);if(e)hit(e,38,'#60eaff');else burst(hero.x+hero.face*45,hero.y,'#60eaff')}
function attack(){if(running)hit(nearest(75),25,'#ffdc70')}
function heal(){if(running&&hero.mp>=30){hero.mp-=30;hero.hp=Math.min(100,hero.hp+30);burst(hero.x,hero.y,'#68ffae')}}
function dash(){if(!running)return;let x=move.x||hero.face,y=move.y,d=Math.hypot(x,y)||1;hero.x=Math.max(20,Math.min(W-20,hero.x+x/d*85));hero.y=Math.max(75,Math.min(H-20,hero.y+y/d*85));hero.inv=.35;burst(hero.x,hero.y,'#bd8cff')}
document.getElementById('magic').onclick=magic;document.getElementById('attack').onclick=attack;document.getElementById('heal').onclick=heal;document.getElementById('dash').onclick=dash;
const stick=document.getElementById('stick'),knob=document.getElementById('knob');
function joystick(e){let r=stick.getBoundingClientRect(),x=e.clientX-(r.left+r.width/2),y=e.clientY-(r.top+r.height/2),d=Math.hypot(x,y),max=36;if(d>max){x=x/d*max;y=y/d*max}move.x=x/max;move.y=y/max;knob.style.left=(34+x)+'px';knob.style.top=(34+y)+'px'}
stick.onpointerdown=e=>{stick.setPointerCapture(e.pointerId);joystick(e)};stick.onpointermove=e=>{if(e.buttons)joystick(e)};function stop(){move.x=move.y=0;knob.style.left='34px';knob.style.top='34px'}stick.onpointerup=stop;stick.onpointercancel=stop;
addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='a')move.x=-1;if(e.key==='ArrowRight'||e.key==='d')move.x=1;if(e.key==='ArrowUp'||e.key==='w')move.y=-1;if(e.key==='ArrowDown'||e.key==='s')move.y=1;if(e.key===' ')attack();if(e.key==='k')magic()});
addEventListener('keyup',e=>{if(['ArrowLeft','a','ArrowRight','d'].includes(e.key))move.x=0;if(['ArrowUp','w','ArrowDown','s'].includes(e.key))move.y=0});
function person(x,y,type,r){ctx.save();ctx.translate(x,y);ctx.fillStyle='#0005';ctx.beginPath();ctx.ellipse(0,r*.8,r,r*.35,0,0,7);ctx.fill();
if(type==='hero'||type==='ally'){ctx.fillStyle=type==='hero'?'#315ed0':'#35a9a1';ctx.beginPath();ctx.moveTo(-r,-r*.1);ctx.lineTo(-r*.6,-r*1.4);ctx.lineTo(r*.6,-r*1.4);ctx.lineTo(r,-r*.1);ctx.lineTo(r*.5,r*.8);ctx.lineTo(-r*.5,r*.8);ctx.fill();ctx.fillStyle='#e8b994';ctx.beginPath();ctx.arc(0,-r*.85,r*.5,0,7);ctx.fill();ctx.fillStyle=type==='hero'?'#cceaff':'#f1eaff';ctx.beginPath();ctx.moveTo(-r*.6,-r*1.05);ctx.lineTo(0,-r*1.9);ctx.lineTo(r*.6,-r*1.05);ctx.fill();ctx.strokeStyle='#78efff';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(r*.7,-r*.2);ctx.lineTo(r*1.3,-r*1.1);ctx.stroke();ctx.fillStyle='#8cf4ff';ctx.beginPath();ctx.arc(r*1.3,-r*1.1,4,0,7);ctx.fill()}
else{ctx.fillStyle='#a4465d';ctx.beginPath();ctx.arc(0,0,r,0,7);ctx.fill();ctx.fillStyle='#ffe48a';ctx.fillRect(-r*.5,-3,4,4);ctx.fillRect(r*.25,-3,4,4)}
ctx.restore()}
function draw(t){let g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#101a3d');g.addColorStop(.65,'#244b58');g.addColorStop(1,'#132d31');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
ctx.fillStyle='#eee5bd';ctx.beginPath();ctx.arc(W*.8,H*.17,22,0,7);ctx.fill();
for(let i=0;i<18;i++){let x=(i*113)%W,y=(i*79)%(H*.65);ctx.fillStyle='#142c32';ctx.beginPath();ctx.arc(x,y,14,0,7);ctx.fill();ctx.fillRect(x-5,y,10,38)}
for(let e of enemies){person(e.x,e.y,'enemy',e.r);ctx.fillStyle='#222';ctx.fillRect(e.x-17,e.y-25,34,4);ctx.fillStyle='#ff5868';ctx.fillRect(e.x-17,e.y-25,34*Math.max(0,e.hp/50),4)}
if(running){person(ally.x,ally.y,'ally',15);person(hero.x,hero.y,'hero',17)}
for(let p of particles){ctx.globalAlpha=Math.max(0,p.life*2);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,3,0,7);ctx.fill();ctx.globalAlpha=1}
}
function update(dt){if(!running)return;time+=dt;hero.x=Math.max(20,Math.min(W-20,hero.x+move.x*190*dt));hero.y=Math.max(75,Math.min(H-20,hero.y+move.y*190*dt));if(move.x)hero.face=Math.sign(move.x);
hero.mp=Math.min(100,hero.mp+dt*6);hero.inv=Math.max(0,hero.inv-dt);ally.x+=(hero.x-45-ally.x)*dt*2;ally.y+=(hero.y+20-ally.y)*dt*2;ally.cd-=dt;
if(ally.cd<=0){let e=nearest(180);if(e){ally.cd=2;hit(e,8,'#9bffe0')}}
for(let e of enemies){let dx=hero.x-e.x,dy=hero.y-e.y,d=Math.hypot(dx,dy)||1;e.x+=dx/d*e.speed*dt;e.y+=dy/d*e.speed*dt;if(d<29&&hero.inv<=0){hero.hp-=10;hero.inv=.7;burst(hero.x,hero.y,'#ff5268')}}
spawnT+=dt;if(spawnT>3&&enemies.length<5){spawn();spawnT=0}
for(let p of particles){p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt}particles=particles.filter(p=>p.life>0);
document.getElementById('ht').textContent=Math.ceil(hero.hp);document.getElementById('mt').textContent=Math.floor(hero.mp);document.getElementById('hp').style.width=hero.hp+'%';document.getElementById('mp').style.width=hero.mp+'%';
if(hero.hp<=0){running=false;document.getElementById('menu').style.display='grid';document.querySelector('#menu h1').textContent='FIM DE JOGO';document.getElementById('start').textContent='JOGAR NOVAMENTE'}}
function loop(t){let dt=Math.min(.04,(t-last)/1000||0);last=t;update(dt);draw(t);requestAnimationFrame(loop)}requestAnimationFrame(loop);
document.getElementById('start').onclick=()=>{hero.hp=100;hero.mp=100;hero.x=W/2;hero.y=H/2;score=0;enemies=[];for(let i=0;i<4;i++)spawn();document.getElementById('score').textContent=0;running=true;document.getElementById('menu').style.display='none'};
</script>
</body>
</html>
